<%- include('../partials/dash-start') %>
<%
  const firstName = user.name.split(' ')[0];
  const doneSteps = steps.filter(s => s.done).length;
  const actions = quotes.filter(qt => qt.state.action || (qt.state.key === 'won' && qt.payment_status !== 'held' && qt.job_status === 'awarded'));
%>
<div class="dash-head">
  <div>
    <p class="eyebrow">G'day <%= firstName %></p>
    <h1>Overview</h1>
  </div>
  <a class="btn" href="/dashboard/jobs">Find jobs</a>
</div>

<% if (doneSteps < steps.length) { %>
  <section class="card setup">
    <div class="setup-top">
      <h2>Get set up to win work</h2>
      <span class="small muted"><%= doneSteps %> of <%= steps.length %> done</span>
    </div>
    <div class="meter"><span style="width:<%= Math.round(doneSteps / steps.length * 100) %>%"></span></div>
    <ol class="steps-list">
      <% steps.forEach(s => { %>
        <li class="<%= s.done ? 'done' : '' %>">
          <span class="tick" aria-hidden="true"><%= s.done ? '✓' : '' %></span>
          <% if (!s.done && s.href) { %><a href="<%= s.href %>"><%= s.label %></a><% } else { %><span><%= s.label %><%= s.done ? '' : '' %></span><% } %>
          <% if (s.done) { %><span class="sr-only">(done)</span><% } %>
        </li>
      <% }) %>
    </ol>
    <% if (profile && profile.status === 'rejected') { %><p class="notice error" style="margin:14px 0 0">We couldn't approve your details. Check them on your <a href="/dashboard/profile">business profile</a>, or reply to our email and we'll tell you what's missing.</p><% } %>
  </section>
<% } %>

<div class="kpis">
  <div class="kpi"><span>Paid to you this month</span><b><%= money(earned.this_month) %></b></div>
  <div class="kpi"><span>Coming to you</span><b><%= money(earned.held) %></b><small>Held until customers sign off</small></div>
  <div class="kpi"><span>Win rate</span><b><%= winRate === null ? '–' : winRate + '%' %></b><small><%= won.length %> won of <%= quotes.length %> quoted</small></div>
  <div class="kpi"><span>Rating</span><b><%= rating ? rating.toFixed(1) : '–' %><% if (rating) { %> <span class="star">★</span><% } %></b><small><%= reviews.length %> review<%= reviews.length === 1 ? '' : 's' %></small></div>
</div>

<div class="dash-cols">
  <div>
    <section class="card">
      <div class="card-head"><h2>Needs you</h2></div>
      <% if (!actions.length) { %>
        <p class="muted small" style="margin:0">Nothing waiting on you. Nice.</p>
      <% } else { %>
        <ul class="action-list">
          <% actions.forEach(qt => { %>
            <li>
              <span class="dot <%= qt.state.action ? 'go' : 'wait' %>" aria-hidden="true"></span>
              <span><strong><%= qt.title %></strong><small><%= qt.state.action ? 'Paid. Go ahead with the job.' : 'Accepted. Waiting for the customer to pay.' %> <%= qt.suburb %></small></span>
              <a class="btn small <%= qt.state.action ? 'accent' : 'ghost' %>" href="/jobs/<%= qt.job_id %>"><%= qt.state.action ? 'Open job' : 'View' %></a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <section class="card">
      <div class="card-head"><h2>New jobs for you</h2><a href="/dashboard/jobs">See all</a></div>
      <% if (!profile || profile.status !== 'approved') { %>
        <p class="muted small" style="margin:0">Jobs that match your trades and areas show here once you're approved. You can <a href="/jobs">browse every open job</a> in the meantime.</p>
      <% } else if (!matches.length) { %>
        <p class="muted small" style="margin:0">No new jobs in your trades and areas right now. We'll email you when one comes in.</p>
      <% } else { %>
        <div class="job-rows tight">
          <% matches.forEach(job => { %><%- include('../partials/job-row', { job }) %><% }) %>
        </div>
      <% } %>
    </section>
  </div>

  <div>
    <% if (can('money')) { %>
      <section class="card">
        <div class="card-head"><h2>Paid to you, last 6 months</h2><a href="/dashboard/earnings">Earnings</a></div>
        <%- include('../partials/bar-chart', { months, width: 340, height: 200, label: 'Money paid to you each month for the last six months' }) %>
      </section>
    <% } %>
    <section class="card">
      <div class="card-head"><h2>Latest reviews</h2><a href="/dashboard/reviews">All reviews</a></div>
      <% if (!reviews.length) { %>
        <p class="muted small" style="margin:0">Reviews from customers show here and on your public profile. They're the biggest thing customers look at when picking a quote.</p>
      <% } else { %>
        <% reviews.slice(0, 2).forEach(r => { %>
          <div class="mini-review">
            <span class="star"><%= '★'.repeat(r.rating) %></span><span class="star off"><%= '★'.repeat(5 - r.rating) %></span>
            <% if (r.comment) { %><p>"<%= r.comment.length > 140 ? r.comment.slice(0, 140) + '…' : r.comment %>"</p><% } %>
            <small><%= r.customer_name.split(' ')[0] %>, <%= r.suburb %></small>
          </div>
        <% }) %>
      <% } %>
    </section>
  </div>
</div>
<%- include('../partials/dash-end') %>
