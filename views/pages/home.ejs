<%- include('../partials/head') %>

<section class="hero">
  <div class="wrap">
    <div>
      <h1>Get quotes from checked tradies across WA</h1>
      <p class="lede">Post a repair, maintenance or building job for a home, a hotel or a mine site. It's free to post. Tradies send you a price, and your payment is held until the work is finished.</p>
      <div class="ctas">
        <a class="btn accent big" href="/start?path=need">Get quotes</a>
        <a class="link-plain" href="/start?path=tradie">I'm a tradie</a>
      </div>
    </div>

    <figure class="preview">
      <div class="docket" aria-label="Example job">
        <div class="docket-body">
          <h3>Regrout shower and replace four cracked floor tiles</h3>
          <div class="docket-meta">Tiling, Bayswater 6053</div>
        </div>
        <div class="docket-quotes">
          <div class="dq">
            <span>Northside Tile &amp; Waterproofing</span><span class="amt">$780</span>
          </div>
          <div class="dq picked">
            <span>J. Russo Tiling</span><span class="amt">$845</span>
          </div>
          <div class="dq">
            <span>Coastal Bathroom Repairs</span><span class="amt">$920</span>
          </div>
        </div>
        <div class="docket-foot">$845 paid and held until the job is signed off</div>
      </div>
      <figcaption>Example only. Business names are made up.</figcaption>
    </figure>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2>What kind of work?</h2>
    <div class="sector-rows">
      <div class="sector-row">
        <h3><a href="/housing">Housing</a></h3>
        <p>Repairs, maintenance and renovations for homeowners, landlords and property managers.</p>
        <a href="/jobs/new?sector=housing">Post a home job</a>
      </div>
      <div class="sector-row">
        <h3><a href="/hotels">Hotels</a></h3>
        <p>Room repairs, air con, bathrooms and refurbishments, worked around your guests.</p>
        <a href="/jobs/new?sector=hotels">Post a hotel job</a>
      </div>
      <div class="sector-row">
        <h3><a href="/mining">Mining</a></h3>
        <p>Camp maintenance, workshop repairs and fabrication, with site requirements listed up front.</p>
        <a href="/jobs/new?sector=mining">Post a mining job</a>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2>How it works</h2>
    <ol class="steps">
      <li>
        <h3>Post your job</h3>
        <p>Say what needs doing and where. Photos help tradies give you a proper price.</p>
      </li>
      <li>
        <h3>Compare quotes</h3>
        <p>Tradies who cover your area send a fixed price. Every one has had their ABN and insurance checked.</p>
      </li>
      <li>
        <h3>Accept and pay</h3>
        <p>Pay by card when you accept. We hold the money, and only the tradie you pick gets your details.</p>
      </li>
      <li>
        <h3>Release when it's done</h3>
        <p>Once you're happy with the work, release the payment and leave a review.</p>
      </li>
    </ol>
    <p class="section-link"><a href="/how-it-works">More about how it works</a></p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2>What do you need done?</h2>
    <ul class="trade-list">
      <% TRADES.filter(t => TRADE_INFO[t.slug]).forEach(t => { %>
        <li><a href="/trades/<%= t.slug %>"><%= t.name %></a></li>
      <% }) %>
      <li><a href="/jobs/new?trade=other">Something else</a></li>
    </ul>
  </div>
</section>

<% if (jobs.length) { %>
<section class="section">
  <div class="wrap">
    <h2>Latest jobs</h2>
    <div class="job-rows">
      <% jobs.forEach(job => { %><%- include('../partials/job-row', { job }) %><% }) %>
    </div>
    <p class="section-link"><a href="/jobs">See all open jobs</a></p>
  </div>
</section>
<% } %>

<section class="band">
  <div class="wrap split">
    <div>
      <h2>Tradies: no lead fees</h2>
      <p>Seeing jobs and quoting is free. If you win the work, we take <%= feePercent %>% when the customer releases payment and the rest goes to your bank.</p>
      <p style="margin-top:24px"><a class="btn" href="/signup?as=tradie">Join as a tradie</a></p>
    </div>
    <div>
      <div class="sum">
        <div><span class="label-col">Quote</span><span><%= money(120000) %></span></div>
        <div><span class="label-col">Our fee (<%= feePercent %>%)</span><span>&minus;<%= money(feeFor(120000)) %></span></div>
        <div><span>You get</span><span><%= money(120000 - feeFor(120000)) %></span></div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/foot') %>
