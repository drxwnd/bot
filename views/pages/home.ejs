<%- include('../partials/head') %>

<section class="hero-photo">
  <div class="hero-media" aria-hidden="true">
    <%- include('../partials/photo', { photo: 'heroCrane', cls: 'hero-img', eager: true, sizes: '(max-width: 900px) 100vw, 128vw' }) %>
  </div>
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="eyebrow rise">Perth and regional WA</p>
      <h1 class="rise">Get quotes from checked tradies across WA</h1>
      <p class="lede rise">Post a repair, maintenance or building job for a home, a hotel or a mine site. It's free to post. Tradies send you a price, and your payment is held until the work is finished.</p>
      <div class="ctas rise">
        <a class="btn accent big" href="/jobs/new">Post a job</a>
        <a class="link-plain" href="/start?path=tradie">I'm a tradie</a>
      </div>
    </div>

    <figure class="preview rise">
      <div class="docket" aria-label="Example job">
        <div class="docket-body">
          <h3>Regrout shower and replace four cracked floor tiles</h3>
          <div class="docket-meta">Tiling, Bayswater 6053</div>
        </div>
        <div class="docket-quotes">
          <div class="dq">
            <span>Northside Tile &amp; Waterproofing</span><span class="amt">$780</span>
          </div>
          <div class="dq picked">
            <span>J. Russo Tiling</span><span class="amt">$845</span>
          </div>
          <div class="dq">
            <span>Coastal Bathroom Repairs</span><span class="amt">$920</span>
          </div>
        </div>
        <div class="docket-foot">$845 paid and held until the job is signed off</div>
      </div>
      <figcaption>Example only. Business names are made up.</figcaption>
    </figure>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2>What kind of work?</h2>
    <div class="tiles">
      <div class="tile">
        <%- include('../partials/photo', { photo: 'tileHousing', sizes: '(max-width: 900px) 100vw, 380px' }) %>
        <div class="tile-body">
          <h3><a class="tile-link" href="/housing">Housing</a></h3>
          <p>Repairs, maintenance and renovations for homeowners, landlords and property managers.</p>
          <span class="tile-go">Home jobs</span>
        </div>
      </div>
      <div class="tile">
        <%- include('../partials/photo', { photo: 'tileHotels', sizes: '(max-width: 900px) 100vw, 380px' }) %>
        <div class="tile-body">
          <h3><a class="tile-link" href="/hotels">Hotels</a></h3>
          <p>Room repairs, air con, bathrooms and refurbishments, worked around your guests.</p>
          <span class="tile-go">Hotel jobs</span>
        </div>
      </div>
      <div class="tile">
        <%- include('../partials/photo', { photo: 'tileMining', sizes: '(max-width: 900px) 100vw, 380px' }) %>
        <div class="tile-body">
          <h3><a class="tile-link" href="/mining">Mining</a></h3>
          <p>Camp maintenance, workshop repairs and fabrication, with site requirements listed up front.</p>
          <span class="tile-go">Mining jobs</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2>How it works</h2>
    <ol class="steps">
      <li>
        <h3>Post your job</h3>
        <p>Say what needs doing and where. Photos help tradies give you a proper price.</p>
      </li>
      <li>
        <h3>Compare quotes</h3>
        <p>Tradies who cover your area send a fixed price. Every one has had their ABN, insurance and any licence their trade needs checked.</p>
      </li>
      <li>
        <h3>Accept and pay</h3>
        <p>Pay by card when you accept. We hold the money, and only the tradie you pick gets your details.</p>
      </li>
      <li>
        <h3>Release when it's done</h3>
        <p>Once you're happy with the work, release the payment and leave a review.</p>
      </li>
    </ol>
    <p class="section-link"><a href="/how-it-works">More about how it works</a></p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2>What do you need done?</h2>
    <ul class="trade-list">
      <% TRADES.filter(t => TRADE_INFO[t.slug]).forEach(t => { %>
        <li><a href="/trades/<%= t.slug %>"><%= t.name %></a></li>
      <% }) %>
      <li><a href="/jobs/new?trade=other">Something else</a></li>
    </ul>
  </div>
</section>

<% if (jobs.length) { %>
<section class="section">
  <div class="wrap">
    <h2>Latest jobs</h2>
    <div class="job-rows">
      <% jobs.forEach(job => { %><%- include('../partials/job-row', { job }) %><% }) %>
    </div>
    <p class="section-link"><a href="/jobs">See all open jobs</a></p>
  </div>
</section>
<% } %>

<section class="band photo-band">
  <div class="banner-media" aria-hidden="true">
    <%- include('../partials/photo', { photo: 'authTradie', cls: 'banner-img' }) %>
  </div>
  <div class="wrap split banner-inner">
    <div>
      <h2>Tradies: no lead fees</h2>
      <p>Seeing jobs and quoting is free. If you win the work, we take <%= feeLabel %> when the customer releases payment and the rest goes to your bank.</p>
      <p style="margin-top:24px"><a class="btn" href="/signup?as=tradie">Join as a tradie</a></p>
    </div>
    <div>
      <div class="sum">
        <div><span class="label-col">Quote</span><span><%= money(120000) %></span></div>
        <div><span class="label-col">Our fee (<%= feePercent %>%)</span><span>&minus;<%= money(feeFor(120000)) %></span></div>
        <div><span>You get</span><span><%= money(120000 - feeFor(120000)) %></span></div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/foot') %>
