<%- include('../partials/head') %>
<div class="wrap">
  <div class="page-head">
    <h1><%= title %></h1>
    <% if (region) { %>
      <p>Get quotes from checked <%= info.plural.toLowerCase() %> who cover <%= area.places.slice(0, 4).join(', ') %> and the rest of <%= label %>. Posting a job is free, and your payment is held until the work is done.</p>
    <% } else { %>
      <p>Get quotes from checked <%= info.plural.toLowerCase() %> across Perth and regional WA. Posting a job is free, and your payment is held until the work is done.</p>
    <% } %>
    <p style="margin-top:24px"><a class="btn accent big" href="/jobs/new?trade=<%= trade.slug %>">Get <%= trade.name.toLowerCase() %> quotes</a></p>
  </div>

  <div class="split page" style="padding-top:8px">
    <div class="doc">
      <h2>Common <%= trade.name.toLowerCase() %> jobs</h2>
      <ul class="tick-list">
        <% info.jobs.forEach(j => { %><li><%= j %></li><% }) %>
      </ul>
    </div>
    <div class="doc">
      <h2>Licensing in WA</h2>
      <p><%= info.licence %></p>
      <h2>Getting an accurate quote</h2>
      <p><%= info.tip %> Photos make a big difference.</p>
      <% if (region) { %>
        <h2>About <%= label %></h2>
        <p><%= area.note %></p>
      <% } %>
    </div>
  </div>
</div>

<section class="section">
  <div class="wrap">
    <h2><%= region ? `${info.plural} covering ${label}` : `${info.plural} on ${siteName}` %></h2>
    <% if (tradies.length) { %>
      <%- include('../partials/tradie-cards', { tradies }) %>
    <% } else { %>
      <div class="empty">We're still signing up <%= info.plural.toLowerCase() %><%= region ? ` in ${label}` : '' %>. Post your job and we'll get it in front of the right people. <a href="/signup?as=tradie">Are you one? Join free.</a></div>
    <% } %>
  </div>
</section>

<% if (jobs.length) { %>
<section class="section">
  <div class="wrap">
    <h2>Open <%= trade.name.toLowerCase() %> jobs<%= region ? ` in ${label}` : '' %></h2>
    <div class="job-rows">
      <% jobs.forEach(job => { %><%- include('../partials/job-row', { job }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section">
  <div class="wrap">
    <% if (region) { %>
      <h2>Other trades in <%= label %></h2>
      <ul class="link-cloud">
        <% Object.keys(TRADE_INFO).filter(s => s !== trade.slug).forEach(s => { %><li><a href="/trades/<%= s %>/<%= region.slug %>"><%= TRADE_INFO[s].plural %></a></li><% }) %>
      </ul>
    <% } %>
    <h2 style="<%= region ? 'margin-top:48px' : '' %>"><%= info.plural %> by area</h2>
    <% REGION_GROUPS.forEach(g => { %>
      <h3 class="link-group"><%= g %></h3>
      <ul class="link-cloud">
        <% REGIONS.filter(r => r.group === g).forEach(r => { %><li><a href="/trades/<%= trade.slug %>/<%= r.slug %>" <%= region && region.slug === r.slug ? 'aria-current="page"' : '' %>><%= r.name.replace(/\s*\(.*\)$/, '') %></a></li><% }) %>
      </ul>
    <% }) %>
  </div>
</section>
<%- include('../partials/foot') %>
