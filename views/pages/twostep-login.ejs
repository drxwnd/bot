<%- include('../partials/head') %>
<div class="auth">
  <h1>Two-step login</h1>
  <% if (typeof error !== 'undefined') { %><div class="notice error"><%= error %></div><% } %>
  <p class="muted">Open your authenticator app and enter the 6-digit code for <%= siteName %>.</p>
  <form method="post" action="/login/2step">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field">
      <label for="code">Code</label>
      <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="20" required autofocus>
      <span class="hint">Lost your phone? Enter one of your backup codes instead (like a1b2c-3d4e5).</span>
    </div>
    <button class="btn accent block big">Log in</button>
  </form>
  <p class="small muted">No phone and no backup codes? Email <a href="mailto:<%= supportEmail %>"><%= supportEmail %></a> from your account's email address.</p>
</div>
<%- include('../partials/foot') %>
