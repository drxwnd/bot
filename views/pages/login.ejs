<%- include('../partials/head') %>
<div class="auth">
  <h1>Log in</h1>
  <% if (typeof error !== 'undefined') { %><div class="notice error"><%= error %></div><% } %>
  <form method="post" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="next" value="<%= next %>">
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" value="<%= email %>" required autofocus>
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
    </div>
    <button class="btn block big">Log in</button>
  </form>
  <p class="alt">New here? <a href="/signup<%= next ? '?next=' + encodeURIComponent(next) : '' %>">Create an account</a> or <a href="/signup?as=tradie">join as a tradie</a>.</p>
  <p class="alt">Forgotten your password? Email <a href="mailto:<%= supportEmail %>"><%= supportEmail %></a> and we'll reset it.</p>
</div>
<%- include('../partials/foot') %>
