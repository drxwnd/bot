<%- include('../partials/head') %>
<%
  // Hidden fields carrying earlier answers through the multi-select (checkbox) steps.
  const carry = (skip) => Object.entries(state)
    .filter(([k, v]) => k !== skip && (Array.isArray(v) ? v.length : v))
    .map(([k, v]) => `<input type="hidden" name="${k}" value="${Array.isArray(v) ? v.join(',') : v}">`)
    .join('');
  const regionShort = (slug) => regionName[slug].replace(/\s*\(.*\)$/, '');
%>
<div class="quiz">
  <div class="quiz-top">
    <% if (back) { %><a href="<%= back %>" class="quiz-back">Back</a><% } else { %><span></span><% } %>
    <span class="quiz-count"><%= step === 'result' ? 'Done' : `${progress.at} of ${progress.total}` %></span>
  </div>
  <div class="quiz-bar"><span style="width:<%= Math.round((progress.at / progress.total) * 100) %>%"></span></div>
  <div class="quiz-body">

  <% if (step === 'path') { %>
    <h1>What brings you here?</h1>
    <div class="opts">
      <a class="opt" href="/jobs/new"><strong>I need work done</strong><span>Post a job and get quotes from checked tradies</span></a>
      <a class="opt" href="<%= link({ path: 'tradie' }) %>"><strong>I'm a tradie</strong><span>Find jobs, no lead fees</span></a>
      <a class="opt" href="/start?path=look"><strong>Just having a look</strong><span>See how it works first</span></a>
    </div>

  <% } else if (step === 'trades') { %>
    <h1>What's your trade?</h1>
    <p class="quiz-sub">Pick all that apply.</p>
    <form method="get" action="/start/pick">
      <%- carry('trades') %>
      <div class="opts grid">
        <% TRADES.filter(t => t.slug !== 'other').forEach(t => { %>
          <label class="opt check"><input type="checkbox" name="pick_trades" value="<%= t.slug %>"><strong><%= t.name %></strong></label>
        <% }) %>
      </div>
      <button class="btn big block quiz-next">Continue</button>
    </form>

  <% } else if (step === 'sectors') { %>
    <h1>What kind of work do you want?</h1>
    <p class="quiz-sub">Pick all that apply. You'll only see jobs that match.</p>
    <form method="get" action="/start/pick">
      <%- carry('sectors') %>
      <div class="opts">
        <% SECTORS.forEach(s => { %>
          <label class="opt check"><input type="checkbox" name="pick_sectors" value="<%= s.slug %>" <%= s.slug === 'housing' ? 'checked' : '' %>><strong><%= s.name %></strong><span><%= s.short %></span></label>
        <% }) %>
      </div>
      <button class="btn big block quiz-next">Continue</button>
    </form>

  <% } else if (step === 'regions') { %>
    <h1>Where will you travel for work?</h1>
    <p class="quiz-sub">Pick all that apply.</p>
    <form method="get" action="/start/pick">
      <%- carry('regions') %>
      <% (state.sectors.length === 1 && state.sectors[0] === 'mining' ? [...REGION_GROUPS].reverse() : REGION_GROUPS).forEach(g => { %>
        <h2 class="quiz-group"><%= g %></h2>
        <div class="opts grid">
          <% REGIONS.filter(r => r.group === g).forEach(r => { %>
            <label class="opt check"><input type="checkbox" name="pick_regions" value="<%= r.slug %>"><strong><%= regionShort(r.slug) %></strong></label>
          <% }) %>
        </div>
      <% }) %>
      <button class="btn big block quiz-next">See my matches</button>
    </form>

  <% } else { %>
    <h1><%= jobs.length ? `${jobs.length} open job${jobs.length === 1 ? '' : 's'} match you` : 'No matching jobs right this minute' %></h1>
    <p class="quiz-sub">
      <%= state.trades.map(t => tradeName[t]).join(', ') %> · <%= state.sectors.map(s => sectorName[s]).join(', ') %> · <%= state.regions.length %> area<%= state.regions.length === 1 ? '' : 's' %>
      · <a href="<%= link({ trades: [], sectors: [], regions: [] }) %>">Change</a>
    </p>

    <% if (jobs.length) { %>
      <div class="job-rows" style="margin-bottom:28px">
        <% jobs.slice(0, 5).forEach(job => { %><%- include('../partials/job-row', { job }) %><% }) %>
      </div>
    <% } else { %>
      <p class="match none">New jobs come in all the time. Sign up now and they'll show on your dashboard as soon as they're posted.</p>
    <% } %>

    <ul class="next-list">
      <li><strong>Free to join and quote.</strong> No lead fees. We take <%= feeLabel %> only when you win a job and the customer releases payment.</li>
      <li><strong>Paid before you start.</strong> The customer pays when they accept your quote and we hold it until the job's signed off.</li>
      <li><strong>Have these ready:</strong> ABN, licence number if your trade needs one, and your public liability insurer and expiry date.</li>
    </ul>

    <% if (user && user.role === 'tradie') { %>
      <a class="btn accent big block" href="/dashboard/profile">Update your business details</a>
    <% } else { %>
      <a class="btn accent big block" href="/signup?as=tradie">Create your tradie account</a>
      <p class="small muted" style="text-align:center;margin-top:12px">We've saved your answers, so your business details will be filled in.</p>
    <% } %>
  <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
