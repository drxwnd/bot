<%- include('../partials/dash-start') %>
<div class="dash-head">
  <div>
    <p class="eyebrow">Hi <%= user.name.split(' ')[0] %></p>
    <h1>Overview</h1>
  </div>
  <% if (can('post')) { %><a class="btn accent" href="/jobs/new">Post a job</a><% } %>
</div>

<% if (!jobs.length) { %>
  <section class="card welcome">
    <h2>Get your first quotes</h2>
    <ol class="welcome-steps">
      <li><strong>Post the job.</strong> Two minutes. Add a photo or two and say what needs doing.</li>
      <li><strong>Compare quotes.</strong> Checked local tradies send you a fixed price. Free, and no obligation.</li>
      <li><strong>Pay when you're ready.</strong> We hold the money and only release it when you say the job's done.</li>
    </ol>
    <% if (can('post')) { %><a class="btn accent big" href="/jobs/new">Post your first job</a><% } %>
  </section>
<% } else { %>
  <div class="kpis">
    <div class="kpi"><span>Open jobs</span><b><%= stats.open %></b></div>
    <div class="kpi"><span>Quotes to look at</span><b><%= stats.quotes %></b></div>
    <div class="kpi"><span>Money held</span><b><%= money(stats.held) %></b><small>Until you sign off</small></div>
    <div class="kpi"><span>Jobs done through us</span><b><%= jobs.filter(j => j.status === 'completed').length %></b><small><%= money(stats.spent) %> in total</small></div>
  </div>

  <section class="card">
    <div class="card-head"><h2>Needs you</h2></div>
    <% if (!actions.length) { %>
      <p class="muted small" style="margin:0">Nothing waiting on you right now. We'll email you when quotes come in.</p>
    <% } else { %>
      <ul class="action-list">
        <% actions.forEach(a => { %>
          <li>
            <span class="dot <%= a.kind === 'compare' || a.kind === 'pay' ? 'go' : 'wait' %>" aria-hidden="true"></span>
            <span><strong><%= a.job.title %></strong><small><%= a.text %></small></span>
            <a class="btn small <%= a.kind === 'compare' || a.kind === 'pay' ? 'accent' : 'ghost' %>" href="<%= a.href %>"><%= a.cta %></a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section>
    <div class="card-head"><h2>Recent jobs</h2><a href="/dashboard/jobs">All jobs</a></div>
    <div class="cj-grid">
      <% jobs.slice(0, 6).forEach(j => { %><%- include('../partials/customer-job-card', { j }) %><% }) %>
    </div>
  </section>
<% } %>
<%- include('../partials/dash-end') %>
