<%- include('../partials/head') %>
<div class="auth">
  <h1>Choose a new password</h1>
  <% if (typeof error !== 'undefined') { %><div class="notice error"><%= error %></div><% } %>
  <form method="post" action="/reset/<%= token %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field">
      <label for="password">New password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required autofocus>
      <span class="hint">At least 8 characters.</span>
    </div>
    <button class="btn accent block big">Save and log in</button>
  </form>
</div>
<%- include('../partials/foot') %>
