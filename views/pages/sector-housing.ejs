<%- include('../partials/head') %>
<section class="banner">
  <div class="banner-media" aria-hidden="true">
    <%- include('../partials/photo', { photo: 'headHousing', cls: 'banner-img', eager: true }) %>
  </div>
  <div class="wrap banner-inner">
    <div class="banner-copy">
      <h1>Repairs and building work for your home</h1>
      <p>For homeowners, landlords and property managers. Post the job for free, compare quotes from checked tradies, and only pay out when the work's done.</p>
      <p class="banner-cta"><a class="btn accent big" href="/jobs/new?sector=housing">Post a home job</a></p>
    </div>
  </div>
</section>
<div class="wrap">

  <div class="split page">
    <div class="doc">
      <h2>What people post</h2>
      <ul class="tick-list">
        <li>Leaking taps, blocked drains and hot water problems</li>
        <li>Cracked tiles, regrouting and resealing showers</li>
        <li>Patching and painting walls and ceilings</li>
        <li>Gutters, roof leaks and broken tiles on the roof</li>
        <li>Fences, gates and reticulation</li>
        <li>Bathroom, kitchen and laundry renovations</li>
      </ul>
    </div>
    <div class="doc">
      <h2>Landlords and property managers</h2>
      <p>Post a job for each property as things come up, whether it's a repair between tenants or a full turnover. Every job, quote and payment stays in your account, so you can see what was spent on each place.</p>
      <p>Once you accept a quote you can pass the tradie's details to the tenant to arrange access.</p>
    </div>
  </div>
</div>
<%- include('../partials/sector-jobs') %>
<%- include('../partials/foot') %>
