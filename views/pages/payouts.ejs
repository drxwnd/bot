<%- include('../partials/dash-start', { dashNav: 'payouts' }) %>
<div class="wrap narrow page">
  <h1>Payouts</h1>
  <p class="muted" style="font-size:1.05rem">Payouts go through Stripe straight to your bank account. You'll need your ABN, BSB and account number, and photo ID. It takes about 5 minutes.</p>

  <div class="box" style="margin-top:28px">
    <% if (!available) { %>
      <h3>Not available yet</h3>
      <p class="small muted" style="margin:0">Online payouts aren't switched on yet. We'll email you as soon as they are.</p>
    <% } else if (ready) { %>
      <h3><span class="tag released">Set up</span>&nbsp; Payouts are on</h3>
      <p class="small muted">When a customer signs off a job, the money minus <%= feeLabel %> goes to your Stripe account and then to your bank, usually within 2 business days.</p>
      <% if (!simulated) { %>
        <form method="post" action="/dashboard/payouts/stripe">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn ghost small">View payouts and bank details on Stripe</button>
        </form>
      <% } %>
    <% } else { %>
      <h3><%= profile.stripe_account_id ? 'Finish setting up payouts' : 'Set up payouts' %></h3>
      <p class="small muted">You'll be sent to Stripe to add your details, then brought back here.</p>
      <form method="post" action="/dashboard/payouts/start">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn accent"><%= profile.stripe_account_id ? 'Continue on Stripe' : 'Set up with Stripe' %></button>
      </form>
      <% if (simulated) { %><p class="small muted" style="margin:10px 0 0">Test mode: this will mark payouts as set up without going to Stripe.</p><% } %>
    <% } %>
  </div>

  <p style="margin-top:28px"><a href="/dashboard">Back to dashboard</a></p>
</div>
<%- include('../partials/dash-end') %>
