<%- include('../partials/head') %>
<div class="wrap">
  <div class="page-head">
    <div class="profile-head">
      <% if (tradie.logo) { %><img class="initials logo-img" src="/uploads/<%= thumb(tradie.logo) %>" alt="<%= tradie.business_name %> logo" width="80" height="80"><% } else { %><div class="initials"><%= tradie.business_name.split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0].toUpperCase()).join('') %></div><% } %>
      <div>
        <h1 style="margin-bottom:6px"><%= tradie.business_name %> <% if (tradie.email_verified_at) { %><span class="tag verified" title="Email confirmed, and ABN, licence and insurance checked by us">Verified</span><% } %></h1>
        <div class="muted">
          <% if (avg) { %><span style="color:var(--accent)">★</span> <%= avg.toFixed(1) %> from <%= reviews.length %> review<%= reviews.length === 1 ? '' : 's' %> &middot; <% } %>
          <%= completed %> job<%= completed === 1 ? '' : 's' %> done through <%= siteName %>
        </div>
      </div>
    </div>
  </div>

  <div class="with-side page" style="padding-top:0">
    <div>
      <% if (tradie.bio) { %>
        <h2 style="font-size:1.4rem">About</h2>
        <p class="prose"><%= tradie.bio %></p>
        <hr>
      <% } %>

      <% if (tradie.tickets) { %>
        <h2 style="font-size:1.4rem">Tickets and inductions</h2>
        <p class="prose"><%= tradie.tickets %></p>
        <hr>
      <% } %>

      <% if (photos.length) { %>
        <h2 style="font-size:1.4rem">Recent work</h2>
        <div class="photo-grid public">
          <% photos.forEach(p => { %>
            <figure><a href="/uploads/<%= p.filename %>" target="_blank" rel="noopener"><img src="/uploads/<%= thumb(p.filename) %>" alt="<%= p.caption || 'Work by ' + tradie.business_name %>" loading="lazy"></a><% if (p.caption) { %><figcaption><span><%= p.caption %></span></figcaption><% } %></figure>
          <% }) %>
        </div>
        <hr>
      <% } %>

      <h2 style="font-size:1.4rem">Reviews</h2>
      <% if (!reviews.length) { %>
        <div class="empty">No reviews yet. Reviews can only be left by customers who've paid for a job through <%= siteName %>.</div>
      <% } %>
      <% reviews.forEach(r => { %>
        <div class="review">
          <div class="stars-static"><%= '★'.repeat(r.rating) %><span style="color:var(--rule-2)"><%= '★'.repeat(5 - r.rating) %></span></div>
          <strong><%= r.title %></strong>
          <div class="small muted"><%= r.customer_name.split(' ')[0] %>, <%= r.suburb %> &middot; <%= shortDate(r.created_at) %></div>
          <% if (r.comment) { %><p class="prose" style="margin:10px 0 0"><%= r.comment %></p><% } %>
          <% if (r.reply) { %><div class="reply"><strong><%= tradie.business_name %> replied</strong><p><%= r.reply %></p></div><% } %>
        </div>
      <% }) %>
    </div>

    <aside>
      <div class="box">
        <dl class="kv">
          <dt>Works in</dt><dd><%= tradie.sectors.split(',').map(s => sectorName[s]).join(', ') %></dd>
          <dt>Trades</dt><dd><% tradie.trades.split(',').filter(s => tradeName[s]).forEach((s, i) => { %><%= i ? ', ' : '' %><% if (TRADE_INFO[s]) { %><a href="/trades/<%= s %>"><%= tradeName[s] %></a><% } else { %><%= tradeName[s] %><% } %><% }) %></dd>
          <dt>Areas</dt><dd><% tradie.regions.split(',').filter(s => regionName[s]).forEach((s, i) => { %><%= i ? ', ' : '' %><a href="/areas/<%= s %>"><%= regionName[s] %></a><% }) %></dd>
          <% if (tradie.years_trading) { %><dt>Experience</dt><dd><%= tradie.years_trading %> years</dd><% } %>
          <dt>ABN</dt><dd>Checked</dd>
          <dt>Insurance</dt><dd>Checked</dd>
          <% if (tradie.licence_no) { %><dt>Licence</dt><dd class="mono"><%= tradie.licence_no %></dd><% } %>
          <dt>Joined</dt><dd><%= shortDate(tradie.created_at) %></dd>
        </dl>
      </div>
    </aside>
  </div>
</div>
<%- include('../partials/foot') %>
