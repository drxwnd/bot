<div class="field">
  <label for="title">What's the job?</label>
  <input id="title" name="title" type="text" required maxlength="120" value="<%= values.title || '' %>" placeholder="e.g. Retile ensuite floor">
</div>
<div class="row">
  <div class="field">
    <label for="client_name">Client name</label>
    <input id="client_name" name="client_name" type="text" required value="<%= values.client_name || '' %>">
  </div>
  <div class="field">
    <label for="client_phone">Client phone</label>
    <input id="client_phone" name="client_phone" type="tel" value="<%= values.client_phone || '' %>">
  </div>
</div>
<div class="row">
  <div class="field">
    <label for="client_email">Client email</label>
    <input id="client_email" name="client_email" type="email" value="<%= values.client_email || '' %>">
  </div>
  <div class="field">
    <label for="price">Agreed price <span class="hint" style="display:inline">(optional, inc. GST)</span></label>
    <input id="price" name="price" type="text" inputmode="decimal" value="<%= values.price_cents ? (values.price_cents / 100).toFixed(2) : (values.price || '') %>" placeholder="Leave blank to charge by the hour">
  </div>
</div>
<div class="field">
  <label for="address">Address</label>
  <input id="address" name="address" type="text" value="<%= values.address || '' %>" autocomplete="street-address">
</div>
<div class="field">
  <label for="description">Details</label>
  <textarea id="description" name="description" style="min-height:110px"><%= values.description || '' %></textarea>
</div>
