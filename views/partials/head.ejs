<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
<%
  // Links in the header for the logged-in person, depending on their account and role.
  const accountLinks = [];
  if (user) {
    if (user.role === 'admin') accountLinks.push({ href: '/admin', label: 'Admin', match: '/admin' });
    if (user.role === 'tradie') {
      if (can('quote')) accountLinks.push({ href: '/dashboard', label: 'Dashboard', match: '/dashboard' });
      accountLinks.push({ href: '/work', label: can('quote') ? 'Work' : 'My jobs', match: '/work' });
    }
    if (user.role === 'customer') accountLinks.push({ href: '/dashboard', label: 'Dashboard', match: '/dashboard' });
    if (user.role !== 'admin' && can('team')) accountLinks.push({ href: '/team', label: 'Team', match: '/team' });
  }
  // Google shows about 60 characters. Add the site name when it fits; trim very long titles (job
  // titles typed by customers) at a word.
  const trimTitle = (t) => t.length <= 60 ? t : t.slice(0, 58).replace(/[\s,;:.-]+\S*$/, '') + '…';
  const fullTitle = !title ? `${siteName} | Tradies for homes, hotels and mine sites in WA`
    : `${title} | ${siteName}`.length <= 62 ? `${title} | ${siteName}` : trimTitle(title);
  const metaDescription = typeof description !== 'undefined' && description ? description : 'Post a repair, maintenance or building job for a home, hotel or mine site in WA. Get quotes from checked tradies and pay only when the job is done.';
%>
  <title><%= fullTitle %></title>
  <meta name="description" content="<%= metaDescription %>">
  <meta name="robots" content="<%= robots %>">
  <link rel="canonical" href="<%= canonical %>">
  <meta name="theme-color" content="#1c1b18">
  <% if (googleVerification) { %><meta name="google-site-verification" content="<%= googleVerification %>"><% } %>

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= siteName %>">
  <meta property="og:locale" content="en_AU">
  <meta property="og:title" content="<%= title || fullTitle %>">
  <meta property="og:description" content="<%= metaDescription %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title || fullTitle %>">
  <meta name="twitter:description" content="<%= metaDescription %>">
  <meta name="twitter:image" content="<%= ogImage %>">

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <% (jsonld || []).forEach(data => { %><script type="application/ld+json"><%- jsonForScript(data) %></script>
  <% }) %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <% if (plausibleDomain) { %><script defer data-domain="<%= plausibleDomain %>" src="https://plausible.io/js/script.js"></script><% } %>
  <% if (typeof quizStep !== 'undefined') { %>
  <meta name="quiz-step" content="<%= quizStep %>">
  <link rel="stylesheet" href="/css/quiz.css">
  <script src="/js/quiz-transitions.js"></script>
  <% } %>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/"><%- include('mark') %>tradebench</a>

    <nav class="nav" aria-label="Main">
      <% SECTORS.forEach(s => { %><a href="<%= s.path %>" class="<%= path === s.path ? 'on' : '' %>"><%= s.name %></a><% }) %>
      <a href="/jobs" class="<%= path === '/jobs' ? 'on' : '' %>">Browse jobs</a>
      <a href="/for-tradies" class="<%= path === '/for-tradies' ? 'on' : '' %>">For tradies</a>
      <div class="right">
        <% if (user) { %>
          <% accountLinks.forEach(l => { %><a href="<%= l.href %>" class="<%= path.startsWith(l.match) ? 'on' : '' %>"><%= l.label %></a><% }) %>
          <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkish" style="text-decoration:none;color:var(--ink-2)">Log out</button></form>
        <% } else { %>
          <a href="/login">Log in</a>
        <% } %>
        <% if (!user || (user.role !== 'tradie' && can('post'))) { %>
          <a class="btn small" href="<%= user ? '/jobs/new' : '/start' %>"><%= user ? 'Post a job' : 'Get started' %></a>
        <% } %>
      </div>
    </nav>

    <details class="menu">
      <summary>Menu</summary>
      <div class="panel">
        <% if (!user || (user.role !== 'tradie' && can('post'))) { %><a href="<%= user ? '/jobs/new' : '/start' %>"><strong><%= user ? 'Post a job' : 'Get started' %></strong></a><% } %>
        <% SECTORS.forEach(s => { %><a href="<%= s.path %>"><%= s.name %></a><% }) %>
        <a href="/jobs">Browse jobs</a>
        <a href="/how-it-works">How it works</a>
        <a href="/for-tradies">For tradies</a>
        <% if (user) { %>
          <% accountLinks.forEach(l => { %><a href="<%= l.href %>"><%= l.label %></a><% }) %>
          <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkish" style="text-decoration:none">Log out</button></form>
        <% } else { %>
          <a href="/login">Log in</a>
        <% } %>
      </div>
    </details>
  </div>
</header>
<% if (flash) { %>
<div class="flash-bar"><div class="wrap"><div class="notice <%= flash.type %>" role="status"><%= flash.text %></div></div></div>
<% } %>
<main id="main">
<% if (breadcrumbs) { %>
<nav class="crumbs wrap" aria-label="Breadcrumb">
  <% breadcrumbs.forEach((c, i) => { %><% if (i < breadcrumbs.length - 1) { %><a href="<%= c.path %>"><%= c.name %></a><span aria-hidden="true">/</span><% } else { %><span aria-current="page"><%= c.name %></span><% } %><% }) %>
</nav>
<% } %>
