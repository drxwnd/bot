<% const p = PHOTOS[photo]; const lazy = !(typeof eager !== 'undefined' && eager); %>
<img class="<%= typeof cls !== 'undefined' ? cls : '' %>" src="/img/photos/<%= p.file %>" alt="<%= p.alt %>" width="<%= p.width %>" height="<%= p.height %>" <%- lazy ? 'loading="lazy"' : 'fetchpriority="high"' %> decoding="async">
<% if (p.attribution) { %><a class="photo-tag" href="<%= p.source %>" rel="nofollow noopener" target="_blank">Photo: <%= p.creator %>, <%= p.license %></a><% } %>
