# Copy to .env and fill in.
NODE_ENV=production
PORT=3000
SITE_NAME=Tradebench
SITE_URL=https://trade-bench.com
SUPPORT_EMAIL=hello@trade-bench.com

# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Your ABN, and the name it's registered to (for a sole trader, your own full name).
# Shown in the footer, terms, privacy page and emails.
BUSINESS_ABN=
LEGAL_NAME=

# Whoever signs up with this email becomes the admin.
ADMIN_EMAIL=

# Fee taken from the tradie's payout, in percent.
PLATFORM_FEE_PERCENT=4

# Smallest fee on any one job, in dollars. Stripe's costs are partly fixed per job (about 30c a card
# payment, plus payout and monthly account fees), so a pure 4% loses money on small jobs.
# Suggested: 15. Leave at 0 for none.
MIN_FEE_DOLLARS=0

# Largest quote allowed, in dollars. In WA, building work over $20,000 generally needs a registered
# builder, a written contract and (for homes) home indemnity insurance. Suggested: 20000. 0 for no cap.
MAX_QUOTE_DOLLARS=0

# Optional fee the customer pays on top at checkout, shown as a "secure payment fee". Covers the card
# fee so your 4% stays yours. Suggested: 2. Leave at 0 for none.
CUSTOMER_FEE_PERCENT=0

# Email. Sign up at resend.com (or postmarkapp.com), verify your domain, and paste the key here.
# Without one, nothing is emailed: no job alerts, quote alerts or password resets.
RESEND_API_KEY=
POSTMARK_TOKEN=
# Must be an address on the domain you verified with the email provider.
EMAIL_FROM=Tradebench <hello@trade-bench.com>

# Optional: privacy-friendly visitor stats from plausible.io. The domain as you added it there.
PLAUSIBLE_DOMAIN=

# Stripe: dashboard.stripe.com > Developers > API keys. Use sk_test_ first, sk_live_ when ready.
STRIPE_SECRET_KEY=
# Stripe: Developers > Webhooks > add endpoint https://YOUR-DOMAIN/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, account.updated,
#         charge.refunded, charge.dispute.created, charge.dispute.closed
STRIPE_WEBHOOK_SECRET=

# Where the database and uploaded photos live. Must be on a persistent disk.
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Google Search Console verification code (the content="..." value from the HTML tag method).
GOOGLE_SITE_VERIFICATION=

# Other hostnames that should 301 redirect to SITE_URL, comma separated.
# e.g. www.trade-bench.com
REDIRECT_HOSTS=
