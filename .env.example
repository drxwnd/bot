# Copy to .env and fill in.
NODE_ENV=production
PORT=3000
SITE_NAME=Tradebench
SITE_URL=https://tradebench.au
SUPPORT_EMAIL=hello@tradebench.au

# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Whoever signs up with this email becomes the admin.
ADMIN_EMAIL=

# Fee taken from the tradie's payout, in percent.
PLATFORM_FEE_PERCENT=4

# Stripe: dashboard.stripe.com > Developers > API keys. Use sk_test_ first, sk_live_ when ready.
STRIPE_SECRET_KEY=
# Stripe: Developers > Webhooks > add endpoint https://YOUR-DOMAIN/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, account.updated
STRIPE_WEBHOOK_SECRET=

# Where the database and uploaded photos live. Must be on a persistent disk.
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Google Search Console verification code (the content="..." value from the HTML tag method).
GOOGLE_SITE_VERIFICATION=

# Other hostnames that should 301 redirect to SITE_URL, comma separated.
# e.g. www.tradebench.au,tradebench.com.au,www.tradebench.com.au
REDIRECT_HOSTS=
